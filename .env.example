# Optional local shell settings; .NET does not automatically load .env files.
# Copy to .env, edit non-secret values, then explicitly export/source if desired.
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5080

# Docker Compose dev profile requires a private file generated as described in docs/persistence.md.
ORDERFLOW_DB_PASSWORD_FILE=./.local/postgres-password
ORDERFLOW_DB_PORT=5432

# Export ConnectionStrings__OrderFlow privately; do not put a real connection string here.
# The normal hosts neither connect nor migrate until persistence is explicitly used.
# PostgreSQL tests use Docker/Testcontainers by default; see docs/testing.md.
# Optional ORDERFLOW_TEST_POSTGRES privately supplies an actual server/admin connection instead.

# Authentication defaults to HTTPS. For loopback HTTP Development only, opt in explicitly:
# Authentication__AllowInsecureHttp=true
# The explicit Worker seed-development-account command is disabled by default.
# Privately supply DevelopmentSeed__Account__Email and DevelopmentSeed__Account__Password.
# DevelopmentSeed__Account__Enabled=true
# DevelopmentSeed__Account__Role=Admin
