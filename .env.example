# Optional local shell settings; .NET does not automatically load .env files.
# Copy to .env, edit non-secret values, then explicitly export/source if desired.
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5080

# No database or provider configuration is needed for milestone 02.
# Future nested .NET settings use double underscores, e.g. ConnectionStrings__OrderFlow.
# Supply future passwords/signing keys through a secret store or private environment.
