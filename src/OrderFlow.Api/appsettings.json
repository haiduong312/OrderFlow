{
  "CatalogCache": { "Enabled": false, "RedisPrefix": "orderflow:catalog:" },
  "Realtime": { "Enabled": false },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'"
      }
    }
  },
  "PaymentCallbacks": { "Enabled": false, "KeyId": "development-v1" },
  "AllowedHosts": "localhost;127.0.0.1",
  "Authentication": {
    "AllowInsecureHttp": false
  },
  "DevelopmentSeed": {
    "Account": {
      "Enabled": false
    }
  }
}
