{
  "OrderExpiry": {
    "Enabled": true,
    "BatchSize": 25,
    "PollIntervalSeconds": 5
  },
  "DevelopmentSeed": {
    "Account": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'"
      }
    }
  }
}
