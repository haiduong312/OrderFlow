{
  "Telemetry": {
    "Enabled": false,
    "OtlpEnabled": false,
    "Endpoint": "http://127.0.0.1:4318/",
    "TraceSampleRatio": 1,
    "SnapshotIntervalSeconds": 15
  },
  "EmailSending": {
    "Enabled": false,
    "Host": "127.0.0.1",
    "Port": 1025,
    "TimeoutSeconds": 10
  },
  "Notifications": {
    "Enabled": false,
    "ConsumersPerQueue": 1,
    "Prefetch": 4
  },
  "OutboxPublishing": {
    "Enabled": false
  },
  "PaymentSettlement": {
    "Enabled": false
  },
  "RefundProcessing": {
    "Enabled": false
  },
  "PaymentReconciliation": {
    "Enabled": false
  },
  "PaymentProcessing": {
    "Enabled": false
  },
  "OrderExpiry": {
    "Enabled": true,
    "BatchSize": 25,
    "PollIntervalSeconds": 5
  },
  "DevelopmentSeed": {
    "Account": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "orderflow-json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'"
      }
    }
  }
}
