worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
worker_shutdown_timeout 20s;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    # No raw path/query, cookies, headers or bodies in access logs.
    log_format safe '$request_method status=$status upstream=$upstream_addr elapsed=$request_time';
    access_log /dev/stdout safe;
    server_tokens off;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    client_max_body_size 1m;
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 2s;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    upstream api {
        zone api 64k;
        server api1:8080 resolve max_fails=1 fail_timeout=5s;
        server api2:8080 resolve max_fails=1 fail_timeout=5s;
    }
    upstream hub {
        zone hub 64k;
        server api1:8080 resolve route=api1 max_fails=1 fail_timeout=5s;
        server api2:8080 resolve route=api2 max_fails=1 fail_timeout=5s;
        sticky cookie __Secure-OrderFlow.Route httponly secure samesite=lax path=/api/hubs/notifications;
    }
    server { listen 8080; location = /healthz { access_log off; return 200; } location / { return 404; } }
    server {
        listen 8443 ssl default_server;
        server_name _;
        ssl_certificate /run/secrets/tls.crt;
        ssl_certificate_key /run/secrets/tls.key;
        return 444;
    }
    server {
        listen 8443 ssl;
        server_name ${ORDERFLOW_PUBLIC_HOST};
        ssl_certificate /run/secrets/tls.crt;
        ssl_certificate_key /run/secrets/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        location = /api { return 404; }
        location /api/ {
            proxy_pass http://api;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Connection '';
            proxy_connect_timeout 3s;
            proxy_read_timeout 75s;
            # An uncertain state-changing request must be recovered by its original durable identity.
            proxy_next_upstream off;
            proxy_no_cache 1;
        }
        location /api/hubs/notifications {
            proxy_pass http://hub;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_connect_timeout 3s;
            proxy_read_timeout 75s;
            proxy_send_timeout 75s;
            proxy_buffering off;
            proxy_cache off;
            proxy_next_upstream off;
        }
        location /assets/ { root /usr/share/nginx/html; try_files $uri =404; expires 1y; add_header Cache-Control 'public, immutable'; }
        location / { root /usr/share/nginx/html; try_files $uri $uri/ /index.html; add_header Cache-Control no-cache; }
    }
}
